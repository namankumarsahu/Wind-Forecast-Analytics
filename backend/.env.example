# Copy to .env for local development. Never commit the real .env.

# --- Web ---------------------------------------------------------------
# Comma-separated list of allowed browser origins (your deployed frontend URL, no trailing slash).
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# --- Elexon BMRS (no API key required) ---------------------------------
ELEXON_BASE_URL=https://data.elexon.co.uk/bmrs/api/v1
HTTP_TIMEOUT_SECONDS=30
HTTP_MAX_RETRIES=3
HTTP_BACKOFF_SECONDS=1.0
FETCH_CONCURRENCY=6

# --- Cache -------------------------------------------------------------
CACHE_DIR=./data_cache
# Only chunks at least this many days old are written to disk (older data no longer changes).
CACHE_MIN_AGE_DAYS=2
# true = never call Elexon; serve only what is already in CACHE_DIR (see `python -m app.prefetch`).
ELEXON_OFFLINE=false
# true = fetch the whole analysis scope in the background at start-up.
PREFETCH_ON_STARTUP=false

# --- Analysis scope: DELIVERY dates covered by the analysis -------------
ANALYSIS_START=2026-01-01
ANALYSIS_END=2026-01-31

# --- Decision cutoff (see README "Forecast cutoff methodology") ---------
DECISION_TIMEZONE=Europe/London
DECISION_CUTOFF_TIME=09:00
DECISION_DAYS_AHEAD=1
# How many days of forecast publications before the cutoff are loaded.
WINDFOR_LOOKBACK_DAYS=3
